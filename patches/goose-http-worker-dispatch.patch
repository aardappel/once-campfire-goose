+// Queues one shared payload for up to 64 exchanges on the same HTTP worker.
+// SENT accepts the batch; each exchange's generation is checked by the worker
+// when dispatching, so closed recipients are skipped. The wire envelope also
+// occupies slot space: 2 + 8 * recipients bytes in addition to data.
+fn mail_send_many(to: const MailAddress[:], tag: i32, data: const u8[:]) -> i32 {
+    guard to.len > 0 && to.len <= 64 else { return TOO_LONG; }
+    var packet: u8[>..] = [];
+    packet.push(to.len as! u8); packet.push(0);
+    for address in to {
+        guard address.box == to[0].box && address.key != 0 else { return STALE; }
+        for i in 8 { packet.push((address.key >> (8*i)) as! u8); }
+    }
+    packet.append(data);
+    return mail_send_worker(key_of(to[0].box), tag, packet);
+}
+
+fn mail_dispatch<F>(key: u64, tag: i32, bytes: const u8[:]) {
+    if key != 0 { F(key, tag, bytes); return; }
+    guard bytes.len >= 2 else { return; }
+    let count: i64 = bytes[0] | (bytes[1] as i64) << 8;
+    let start = 2 + 8*count;
+    guard count > 0 && count <= 64 && start <= bytes.len else { return; }
+    for n in count {
+        var recipient: u64 = 0;
+        for i in 8 { recipient |= (bytes[2+8*n+i] as u64) << (8*i); }
+        if recipient != 0 { F(recipient, tag, bytes[start..]); }
+    }
+}
+
 // The most bytes a message to to's box may have, or -1 for an address that's
 // STALE, including a stopped box. Any thread may call it.
 fn mail_slot_size(to: MailAddress) -> i32 { mail_slot_size_c(key_of(to.box), to.key) }
